# Copy to a private, ignored file. Never commit real secrets.
BASE_URL=http://localhost:3002
BETTER_AUTH_URL=http://127.0.0.1:3003
AUTH_MODE=password
PORT=3003
HOST_BACKEND_PORT=127.0.0.1:3001:3001
HOST_CLIENT_PORT=127.0.0.1:3002:3002
# Match the inspected Rybbit checkout's upstream commit (metadata SHA tag).
IMAGE_TAG=sha-877e3c6
OPENSEO_IMAGE=ghcr.io/every-app/open-seo-standalone:0.1.22
OPENSEO_BUNDLE_DIR=../open-seo/dist/celld
DISABLE_SIGNUP=false
DISABLE_TELEMETRY=true
CLUSTER_WORKERS=1
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
STORAGE_ACCESS_KEY=kedi-local
STORAGE_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
OPENSEO_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
