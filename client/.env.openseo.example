# Merge these into client/.env.local. Existing Rybbit configuration stays intact.
# OpenSEO must run with AUTH_MODE=password and a real user account.
OPENSEO_BASE_URL=http://127.0.0.1:3003
# Docker only: keep the public origin above; route requests over its private network.
# OPENSEO_INTERNAL_URL=http://web
# Set behind Docker/proxies when Next.js sees an internal bind hostname.
# OPENSEO_FRONTEND_ORIGIN=http://localhost:3002
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never use this placeholder as a real secret. Do not prefix it with NEXT_PUBLIC_.
OPENSEO_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Optional server-side address of the EXISTING Rybbit backend.
# Falls back to NEXT_PUBLIC_BACKEND_URL. Use an origin, without /api.
RYBBIT_INTERNAL_URL=http://localhost:3001
